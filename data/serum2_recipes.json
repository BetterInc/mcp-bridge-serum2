{
  "_about": {
    "version": 1,
    "target": "Serum 2 (VST3) as exposed by FL Studio 2026 plugin parameters; names verified against docs/serum2/params.json",
    "value_format": "Values are FL display strings (real units). The bridge resolves each by sweeping the parameter's normalized value and matching FL's display text (e.g. 'Filter 1 Freq' -> '180 Hz', 'A Octave' -> '-1 oct', 'A Level' -> '75%' matches '75% [-5.0 dB]'). Plain numbers (e.g. unison 7) match the leading number of the display text.",
    "notes_format": "pattern.notes = [[beat, length_beats, semitones_from_root, velocity], ...] over pattern.bars; root_midi is standard MIDI (33 = A1 = 55 Hz; FL's piano roll shows it one octave higher, as 'A2').",
    "not_settable": "Serum 2 does NOT expose modulation-matrix source/destination (only 'Mod N Amount'/'Mod N Out' of slots that already exist in the loaded preset), oscillator wavetable choice, LFO shapes, or FX types (only generic 'FX Bus N Param k'). Those are listed under not_a_parameter. Modulation the bridge must recreate is given under host_automation (FL automation clips on a Serum parameter, e.g. a tempo-synced LFO on 'Filter 1 Freq'), and FX under mixer_fx (FL native plugins on the channel's mixer insert).",
    "init_assumption": "Start from Serum 2's default init patch (Osc A = basic saw wavetable). Recipes set every relevant parameter explicitly so the previous state does not leak in: disable what is not used ('B Enable','C Enable','Noise Enable','Sub Enable' = 'Off')."
  },

